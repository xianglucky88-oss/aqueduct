# 复制为 .env 后按需修改。真实值不要提交。
DATABASE_URL=postgres://aqueduct:aqueduct@localhost:5432/aqueduct?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# 副本身份。Kubernetes 用 POD_NAME（downward API），本地留空则由主机名生成。
WORKER_ID=worker-local

# 运行参数：租约、终止宽限、调度与并发。
LEASE_TTL=45s
LEASE_RENEW_INTERVAL=15s
SHUTDOWN_GRACE=20s
SCHEDULER_POLL=1s
MAX_CONCURRENT_SITES=2
READINESS_CACHE_TTL=2s

# 连接池与单轮页数上限。多副本时注意 副本数 * DB_MAX_OPEN_CONNS
# 不超过数据库 max_connections 的 80%。
DB_MAX_OPEN_CONNS=8
DB_MAX_IDLE_CONNS=2
MAX_PAGES=200
