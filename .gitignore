# ============================================================
# 内部出题资料（缺陷清单等，绝不进仓库）
# ============================================================
.internal/
*known-issues*
docs/internal/

# ============================================================
# 凭据与敏感配置（文档硬性要求：.env / 密钥 / 连接串 / token）
# ============================================================
.env
.env.*
!.env.example
*.env.local
*.env.production

# 私钥与证书
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
ssh/
id_rsa*
id_ed25519*

# 凭据文件
secrets/
credentials*
*credentials.json
.netrc
.pgpass
.pg_service.conf
.my.cnf
.npmrc
.pypirc
.docker/config.json

# 连接串与 token
*connection.string
*conn.txt
*.token
*token.txt
*.secret

# 云与基础设施状态
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Kubernetes
kubeconfig
*.kubeconfig
*.kubeconfig.yaml

# ============================================================
# 构建产物
# ============================================================
bin/
dist/
build/
*.out
*.test
*.exe
*.dll
*.so
*.dylib
coverage.txt
coverage.html

# ============================================================
# 依赖缓存
# ============================================================
vendor/
.go/pkg/
.gocache/

# ============================================================
# 运行数据与本地状态
# ============================================================
tmp/
pgdata/
data/
*.log
*.pid
*.sock

# ============================================================
# 编辑器与系统
# ============================================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
